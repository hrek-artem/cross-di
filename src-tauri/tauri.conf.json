{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cross-di",
  "version": "0.1.0",
  "identifier": "xanksax.cross-di",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cross-di",
        "width": 340,
        "height": 190,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "devtools": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Cross Dynamic Island",
        "width": 1000,
        "height": 540,
        "minWidth": 1000,
        "minHeight": 540,
        "decorations": false,
        "devtools": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../extensions/chromium/": "browser-extension/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer/browser-hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
