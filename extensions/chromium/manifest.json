{
  "manifest_version": 3,
  "name": "Cross Dynamic Island",
  "version": "0.4.3",
  "description": "Connect browser media to your local Cross Dynamic Island app.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect Dynamic Island",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "video-source.js",
        "soundcloud.js",
        "spotify.js",
        "player.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "soundcloud.js",
        "spotify.js",
        "dom-player.js",
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "key": ""
}
